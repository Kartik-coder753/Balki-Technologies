rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation for User Profile
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName']) &&
             data.uid == request.auth.uid &&
             data.email is string && data.email.size() <= 150 &&
             data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100;
    }

    // Validation for Review
    function isValidReview(data) {
      return data.keys().hasAll(['id', 'userId', 'authorName', 'rating', 'targetType', 'headline', 'reviewText']) &&
             data.userId == request.auth.uid &&
             data.authorName is string && data.authorName.size() <= 100 &&
             data.rating is number && data.rating >= 1 && data.rating <= 5 &&
             (data.targetType == 'website' || data.targetType == 'product') &&
             data.headline is string && data.headline.size() <= 150 &&
             data.reviewText is string && data.reviewText.size() <= 1500;
    }

    // Validation for Order
    function isValidOrder(data) {
      return data.keys().hasAll(['id', 'userId', 'customerName', 'customerEmail', 'totalAmount', 'paymentStatus']) &&
             data.userId == request.auth.uid &&
             data.customerName is string && data.customerName.size() <= 100 &&
             data.customerEmail is string && data.customerEmail.size() <= 150 &&
             data.totalAmount is number && data.totalAmount >= 0;
    }

    // Users Collection (Client Credentials & Profile)
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidUser(incoming());
      allow delete: if false;
    }

    // Products Collection (Product Catalog)
    match /products/{productId} {
      allow read: if isSignedIn();
      allow write: if false; // Read-only on client; managed by admin/seed
    }

    // Reviews Collection: Registered users can read and post verified reviews
    match /reviews/{reviewId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(reviewId) && isValidReview(incoming());
      allow update: if isSignedIn() && (existing().userId == request.auth.uid || incoming().diff(existing()).affectedKeys().hasOnly(['likesCount']));
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    // Orders Collection: Secured to purchasing registered client
    match /orders/{orderId} {
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(orderId) && isValidOrder(incoming());
      allow update: if isSignedIn() && existing().userId == request.auth.uid;
      allow delete: if false;
    }
  }
}
