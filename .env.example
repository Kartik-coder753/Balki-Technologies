# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional Client Firebase Environment Variables (Defaults to firebase-applet-config.json)
# CRITICAL: VITE_FIREBASE_AUTH_DOMAIN must always be the Firebase domain (<project-id>.firebaseapp.com)
# and never your custom domain or vercel domain.
VITE_FIREBASE_PROJECT_ID="gen-lang-client-0184886612"
VITE_FIREBASE_AUTH_DOMAIN="gen-lang-client-0184886612.firebaseapp.com"
VITE_FIREBASE_API_KEY="AIzaSy..."
VITE_FIREBASE_DATABASE_ID="ai-studio-balkitechnologie-18d8f381-5363-412d-b9cb-53b6b6bbba92"

# Configurable Order Approval Threshold in INR (Default: 5000)
# Orders below this threshold proceed with automatic payment checkout.
# Orders of this threshold or above require owner approval.
ORDER_APPROVAL_THRESHOLD_INR="5000"

# Official Razorpay Payment Gateway Configuration (TEST MODE)
# Key ID is public/publishable, Key Secret must ONLY exist on the secure backend.
# Obtain from https://dashboard.razorpay.com/app/keys in Test Mode
RAZORPAY_KEY_ID="rzp_test_YOUR_TEST_KEY_ID"
RAZORPAY_KEY_SECRET="YOUR_TEST_KEY_SECRET"
